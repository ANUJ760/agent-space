# ==============================================================================
# Agent Space — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit .env with production credentials to source control.

# ------------------------------------------------------------------------------
# 1. Core Application
# ------------------------------------------------------------------------------
ENVIRONMENT=development
WORKSPACE_ROOT=./var/workspaces
GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
COLLAB_PORT=1234
COLLAB_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_COLLAB_URL=ws://localhost:1234
DEBUG=true
APP_NAME="Agent Space"
APP_VERSION="0.1.0"
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-prod
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL / SQLAlchemy)
# Authoritative state for organizations, users, projects, tasks, workflows, outbox
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agentspace
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ------------------------------------------------------------------------------
# 3. Cache & Ephemeral State (Redis)
# Presence, active agent sessions, fast cache, websocket connection state
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_TIMEOUT=5

# ------------------------------------------------------------------------------
# 4. Event Bus & Messaging (NATS / JetStream)
# Asynchronous domain events, task notifications, agent streams
# ------------------------------------------------------------------------------
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=AGENT_SPACE_EVENTS
NATS_CONSUMER_GROUP=agentspace-backend

# ------------------------------------------------------------------------------
# 5. Durable Workflow Engine (Temporal)
# Long-running tasks, orchestrations, human-in-the-loop signals
# ------------------------------------------------------------------------------
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=agent-space-tasks

# ------------------------------------------------------------------------------
# 6. Identity & Authentication (Keycloak / OIDC)
# OpenID Connect, OAuth2, JWT verification
# ------------------------------------------------------------------------------
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=agentspace
KEYCLOAK_CLIENT_ID=agentspace-backend
KEYCLOAK_CLIENT_SECRET=keycloak-client-secret-placeholder
KEYCLOAK_AUDIENCE=agentspace-backend

# ------------------------------------------------------------------------------
# 7. Semantic Memory & Vector Search (Qdrant)
# Vector embeddings for task history, code snippets, project memory
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agent_space_memory

# ------------------------------------------------------------------------------
# 8. Artifact & Object Storage (SeaweedFS / S3 / Azure Blob)
# Build outputs, logs, patches, diffs, images, large attachments
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=s3_compatible
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_BUCKET=agent-artifacts
STORAGE_ACCESS_KEY=seaweedfs-access
STORAGE_SECRET_KEY=seaweedfs-secret
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=false

# ------------------------------------------------------------------------------
# 9. Source Control & Repository Management (Gitea)
# Isolated agent branches, PRs, worktree repositories
# ------------------------------------------------------------------------------
GITEA_URL=http://localhost:3001
GITEA_ADMIN_USER=gitea_admin
GITEA_ADMIN_TOKEN=gitea-admin-token-placeholder

# ------------------------------------------------------------------------------
# 10. Model Gateway (Ollama local / vLLM prod)
# LLM inference abstraction for coding, research, review, testing agents
# ------------------------------------------------------------------------------
MODEL_GATEWAY_PROVIDER=ollama
MODEL_GATEWAY_BASE_URL=http://localhost:11434
MODEL_GATEWAY_API_KEY=
DEFAULT_CHAT_MODEL=llama3.1:8b
DEFAULT_CODE_MODEL=qwen2.5-coder:7b
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=4096

# ------------------------------------------------------------------------------
# 10b. Shared default agent and user-supplied agent providers
# User keys stay in each browser. The shared Gemini key stays on the backend.
# Gemini 2.5 Flash has a free tier, subject to Google quotas.
# ------------------------------------------------------------------------------
DEFAULT_AGENT_PROVIDER=gemini
DEFAULT_AGENT_MODEL=gemini-2.5-flash
# Shared default planner/agent key. Keep this server-side; never prefix NEXT_PUBLIC_.
DEFAULT_GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
USER_SUPPLIED_API_KEYS_ENABLED=true

# ------------------------------------------------------------------------------
# 11. Tool Execution Sandbox (Docker / gVisor)
# Untrusted agent execution boundary
# ------------------------------------------------------------------------------
SANDBOX_TYPE=docker
SANDBOX_DOCKER_IMAGE=python:3.11-slim
SANDBOX_NETWORK_ISOLATION=true
SANDBOX_TIMEOUT_SECONDS=300
SANDBOX_MAX_MEMORY_MB=1024
SANDBOX_MAX_CPUS=1.0

# ------------------------------------------------------------------------------
# 12. Observability & Telemetry (OpenTelemetry, Prometheus, Loki)
# Traces, metrics, structured logging
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agent-space-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_METRICS_ENABLED=true
