FROM node:24-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/frontend/package.json apps/frontend/package.json
COPY apps/collab/package.json apps/collab/package.json
RUN npm ci --ignore-scripts
COPY apps/frontend apps/frontend
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_COLLAB_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_COLLAB_URL=$NEXT_PUBLIC_COLLAB_URL
RUN npm run build --workspace=@agent-space/frontend

FROM node:24-alpine
WORKDIR /app
RUN addgroup -S -g 10001 nodejs && adduser -S -u 10001 -G nodejs nextjs
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/frontend ./apps/frontend
ENV NODE_ENV=production
USER 10001:10001
EXPOSE 3000
CMD ["npm", "run", "start", "--workspace=@agent-space/frontend"]
